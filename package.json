{
  "name": "scrapdrop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "NODE_ENV=test AI_MODE=fixture node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start:batchstudio": "node --import tsx examples/batchstudio/server.ts",
    "demo": "node --env-file-if-exists=.env --import tsx scripts/demo.ts",
    "ai:on": "node --import tsx scripts/ai-mode.ts live",
    "ai:off": "node --import tsx scripts/ai-mode.ts fixture",
    "mcp:manufacturing": "node --import tsx scripts/manufacturing-mcp.ts",
    "test:production": "NODE_ENV=test AI_MODE=fixture node --import tsx --test tests/production-http.e2e.test.ts",
    "sandbox:practice": "SCRAPDROP_PRACTICE_MODE=sandbox node --env-file-if-exists=.env --import tsx scripts/demo.ts",
    "dev:restorecart": "node --env-file-if-exists=.env --import tsx server/restorecart/index.ts",
    "start:restorecart": "NODE_ENV=production node --env-file-if-exists=.env --import tsx server/restorecart/index.ts",
    "test:restorecart": "NODE_ENV=test node --import tsx --test tests/restorecart*.test.ts",
    "restorecart:ai:on": "node --import tsx scripts/restorecart-ai.ts live",
    "restorecart:ai:off": "node --import tsx scripts/restorecart-ai.ts off",
    "restorecart:ai:fixture": "node --import tsx scripts/restorecart-ai.ts fixture",
    "test:restorecart:live-ai": "node --env-file-if-exists=.env --import tsx scripts/restorecart-live-check.ts",
    "restorecart:demo-accounts": "node --env-file-if-exists=.env --import tsx scripts/restorecart-demo-accounts.ts"
  },
  "dependencies": {
    "@bryntum/schedulerpro": "npm:@bryntum/schedulerpro-trial@7.3.7",
    "@bryntum/schedulerpro-react": "7.3.7",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "image-size": "2.0.4",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "papaparse": "5.7.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/papaparse": "5.5.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
