# TaskSlice — local configuration. Keep this file private.
# Sandbox app credentials come from Apps & Credentials > Sandbox > your app.
# Buyer/seller passwords are only for signing in on PayPal; never enter them here.

PORT=4317
APP_BASE_URL=http://127.0.0.1:4317
APP_MODE=sandbox
PAYPAL_ENV=sandbox

# Required for PayPal checkout: your sandbox APP credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Required for verified notifications after registering an HTTPS webhook URL.
PAYPAL_WEBHOOK_ID=

# Optional extra seller check. Leave blank to identify the seller from PayPal.
PAYPAL_MERCHANT_ID=

# Google AI Studio API credentials (server only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Marketplace AI: fixture is the development/test default. A key alone never enables calls.
AI_MODE=fixture
# Final verification only: at most three live requests per server process.
AI_TEST_REQUEST_BUDGET=3
ALLOW_LIVE_AI_TESTS=false
# Only this loopback origin can receive local provider contract tests.
PROVIDER_REFERENCE_ORIGIN=http://127.0.0.1:4418

# Optional: exact existing TaskSlice account ID allowed to handle reference-app requests.
# Copy it from For builders > Connect the TaskSlice reference-app inbox.
# This is not a PayPal merchant ID. Unset means requests await owner setup.
TASKSLICE_REFERENCE_OWNER_ACCOUNT_ID=

# Exact approved provider origins, comma-separated. HTTPS is required in production.
# Example: https://your-batchstudio-service.onrender.com
PROVIDER_ALLOWED_ORIGINS=

# Optional: one registered provider operated by the reference-owner account above.
# Enables the fixed $6 sandbox package for this operator-owned demonstration only.
TASKSLICE_DEMO_PROVIDER_ID=
